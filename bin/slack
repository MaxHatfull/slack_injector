#!/bin/zsh
set -u
DIR="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${SLACK_CDP_PORT:-9222}"
# Slack 4.53+ refuses --remote-debugging-port on its default profile, so use a separate one.
PROFILE="${SLACK_PROFILE_DIR:-$HOME/Library/Application Support/Slack-injector}"

if ! NODE="$(command -v node)"; then
  echo "node not found on PATH. Install Node 22 or newer." >&2
  exit 1
fi

if pgrep -q -f "Slack.app/Contents/MacOS/Slack"; then
  if ! curl -s "localhost:$PORT/json/version" >/dev/null; then
    echo "Slack is running without a debugging port. Quit Slack and run slack again." >&2
    exit 1
  fi
else
  open -a Slack --args --remote-debugging-port="$PORT" --user-data-dir="$PROFILE"
  for _ in {1..20}; do
    curl -s "localhost:$PORT/json/version" >/dev/null && break
    sleep 1
  done
  if ! curl -s "localhost:$PORT/json/version" >/dev/null; then
    echo "Slack did not open a debugging port on $PORT. Try running it directly to see why:" >&2
    echo "  /Applications/Slack.app/Contents/MacOS/Slack --remote-debugging-port=$PORT --user-data-dir=\"$PROFILE\"" >&2
    exit 1
  fi
fi

if pgrep -q -f "$DIR/inject.mjs"; then
  echo "injector already running (log: $DIR/inject.log)"
else
  nohup "$NODE" "$DIR/inject.mjs" >> "$DIR/inject.log" 2>&1 &
  disown
  echo "injector started (log: $DIR/inject.log)"
fi
